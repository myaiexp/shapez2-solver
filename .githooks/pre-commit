#!/usr/bin/env bash
# Pre-commit gate — runs the full test suite before allowing a commit.
# Activate once per clone:   git config core.hooksPath .githooks
# Bypass a single commit:    git commit --no-verify
#
# The suite, its coverage floor and the solve.mjs checks live in tests/run-suite.sh,
# which the CI `test` job in .github/workflows/pages.yml runs too.
set -uo pipefail

echo "pre-commit: running test suite…"
if ! out=$(bash tests/run-suite.sh 2>&1); then
  echo "$out"
  echo "✗ pre-commit FAILED: tests/run-suite.sh"
  exit 1
fi
echo "✓ pre-commit: all tests passed"
